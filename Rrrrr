(function(){
    let d = localStorage.getItem('rs_device_id');
    if(!d){
        d = 'DEV-' + Math.random().toString(36).substr(2, 9).toUpperCase();
        localStorage.setItem('rs_device_id', d);
    }

    fetch('https://rs-auto-ai-default-rtdb.firebaseio.com/devices/' + d + '.json')
    .then(r => r.json())
    .then(data => {
        let now = new Date().getTime();
        let isValid = data && data.active === true && (!data.expireAt || now <= data.expireAt);
        if(isValid){
            startApp();
        } else {
            showLockCard(d);
        }
    })
    .catch(() => {
        showLockCard(d);
    });

    function showLockCard(id){
        if(document.getElementById('rs-lock-card')) return;
        let o = document.createElement('div');
        o.id = 'rs-lock-card';
        o.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;background:rgba(0,0,0,0.85);z-index:9999999;display:flex;align-items:center;justify-content:center;font-family:Arial,sans-serif;';
        o.innerHTML = '<div style="background:#161b22;border:2px solid #00f2fe;border-radius:15px;padding:25px;width:90%;max-width:360px;text-align:center;color:#fff;box-shadow:0 0 20px rgba(0,242,254,0.3);">' +
            '<h2 style="margin:0 0 10px 0;font-size:22px;color:#00f2fe;font-weight:bold;">RS-AUTO-AI</h2>' +
            '<hr style="border:0;height:1px;background:#30363d;margin-bottom:20px;">' +
            '<p style="font-size:13px;color:#8b949e;margin-bottom:8px;">আপনার ডিভাইস আইডি:</p>' +
            '<div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:15px;">' +
            '<input type="text" id="rs-dev-id-val" value="' + id + '" readonly style="background:#0d1117;border:1px solid #30363d;color:#00ff66;padding:8px;border-radius:6px;text-align:center;font-weight:bold;font-size:13px;width:160px;outline:none;">' +
            '<button id="rs-copy-id-btn" style="background:#1f6feb;color:#fff;border:none;padding:8px 12px;border-radius:6px;cursor:pointer;font-weight:bold;font-size:12px;">কপি</button>' +
            '</div>' +
            '<p style="font-size:13px;line-height:1.5;margin-bottom:20px;color:#c9d1d9;">RS-AUTO-AI চালানোর জন্য নিচের CONTACT ADMIN বটনে ক্লিক করে এডমিন কে মেসেজ দেন।</p>' +
            '<a href="https://t.me/Rafi9283" target="_blank" style="display:block;width:100%;padding:12px 0;background:#229ED9;color:#fff;text-decoration:none;border-radius:8px;margin-bottom:15px;box-sizing:border-box;">CONTACT ADMIN</a>' +
            '<button onclick="document.getElementById(\'rs-lock-card\').remove()" style="background:transparent;border:none;color:#8b949e;cursor:pointer;font-size:12px;">বন্ধ করুন</button>' +
            '</div>';
        document.body.appendChild(o);
        document.getElementById('rs-copy-id-btn').onclick = function(){
            navigator.clipboard.writeText(id).then(function(){
                document.getElementById('rs-copy-id-btn').innerText = 'কপি হয়েছে!';
                setTimeout(function(){ document.getElementById('rs-copy-id-btn').innerText = 'কপি'; }, 2000);
            });
        };
    }

    function startApp(){
        if(window.rsAutoLoaded) return;
        window.rsAutoLoaded = true;
        var s = document.createElement('style');
        s.innerHTML = '@keyframes rsP{0%{box-shadow:0 0 0 0 rgba(0,242,254,0.7)}70%{box-shadow:0 0 0 15px rgba(0,242,254,0)}100%{box-shadow:0 0 0 0 rgba(0,242,254,0)}}' +
            '#rs-w{position:fixed;top:45%;right:20px;z-index:999999;display:flex;flex-direction:column;align-items:center;font-family:sans-serif;user-select:none;touch-action:none;cursor:grab;}' +
            '#rs-c{position:absolute;top:-10px;right:-10px;width:24px;height:24px;background:#ff4757;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:12px;cursor:pointer;border:2px solid #111;z-index:10;}' +
            '#rs-btn{width:90px;height:90px;border-radius:50%;background:#0d1117;border:3px solid #00f2fe;box-shadow:0 0 15px rgba(0,242,254,0.4);display:flex;flex-direction:column;align-items:center;justify-content:center;cursor:pointer;animation:rsP 2s infinite;}' +
            '#rs-st{font-size:9px;font-weight:800;color:#00f2fe;text-transform:uppercase;margin-bottom:2px;}' +
            '#rs-br{font-size:13px;font-weight:900;color:#fff;letter-spacing:1px;}' +
            '#rs-sub{font-size:8px;color:#a0aec0;margin-top:2px;}';
        document.head.appendChild(s);

        var w = document.createElement('div');
        w.id = 'rs-w';
        w.innerHTML = '<div id="rs-c">&times;</div><div id="rs-btn"><div id="rs-st">OFF</div><div id="rs-br">RS AUTO</div><div id="rs-sub">AI SIGNAL</div></div>';
        document.body.appendChild(w);

        var run = false, syn = window.speechSynthesis, dx = 0, dy = 0, sx = 0, sy = 0, drag = false;
        w.onmousedown = w.ontouchstart = function(e){
            if(e.target.id === 'rs-c') return;
            drag = true;
            var ev = e.touches ? e.touches[0] : e;
            sx = ev.clientX - dx; sy = ev.clientY - dy;
        };
        window.onmousemove = window.ontouchmove = function(e){
            if(!drag) return;
            var ev = e.touches ? e.touches[0] : e;
            dx = ev.clientX - sx; dy = ev.clientY - sy;
            w.style.transform = 'translate(' + dx + 'px,' + dy + 'px)';
        };
        window.onmouseup = window.ontouchend = function(){ drag = false; };

        document.getElementById('rs-c').onclick = function(e){
            e.stopPropagation();
            if(syn) syn.cancel();
            w.remove();
            window.rsAutoLoaded = false;
        };

        function speak(txt, callback){
            if(!syn){ if(callback) callback(); return; }
            syn.cancel();
            var u = new SpeechSynthesisUtterance(txt);
            u.lang = 'bn-BD'; u.rate = 0.85; u.pitch = 0.9;
            var voices = syn.getVoices();
            var v = voices.find(function(x){ return x.lang.includes('bn') && (x.name.toLowerCase().includes('male') || x.name.toLowerCase().includes('bangladesh') || x.name.toLowerCase().includes('google')); }) || voices.find(function(x){ return x.lang.includes('bn'); });
            if(v) u.voice = v;
            if(callback) u.onend = callback;
            syn.speak(u);
        }

        function getBalancedRandomSignal(){
            window.rsHistory = window.rsHistory || [];
            window.rsCounts = window.rsCounts || {BUY:0, SELL:0};
            var rand = Math.random();
            var sig = 'BUY';
            if(window.rsCounts.BUY > window.rsCounts.SELL){
                sig = rand < 0.75 ? 'SELL' : 'BUY';
            } else if(window.rsCounts.SELL > window.rsCounts.BUY){
                sig = rand < 0.75 ? 'BUY' : 'SELL';
            } else {
                sig = rand < 0.5 ? 'BUY' : 'SELL';
            }
            var len = window.rsHistory.length;
            if(len >= 2 && window.rsHistory[len-1] === sig && window.rsHistory[len-2] === sig){
                if(Math.random() < 0.85){
                    sig = sig === 'BUY' ? 'SELL' : 'BUY';
                }
            }
            window.rsHistory.push(sig);
            window.rsCounts[sig]++;
            if(window.rsHistory.length > 10) window.rsHistory.shift();
            return sig;
        }

        var btn = document.getElementById('rs-btn'), st = document.getElementById('rs-st');
        btn.onclick = function(){
            if(drag) return;
            if(run){
                run = false;
                if(syn) syn.cancel();
                st.innerText = 'OFF';
                st.style.color = '#00f2fe';
                btn.style.borderColor = '#00f2fe';
            } else {
                run = true;
                var url = window.location.href.toLowerCase();
                var isTradingPage = url.includes('qx') || url.includes('quotex') || url.includes('pocketoption') || url.includes('iqoption') || url.includes('olymptrade') || url.includes('trade');
                if(!isTradingPage){
                    st.innerText = 'NO CHART';
                    st.style.color = '#ff4757';
                    btn.style.borderColor = '#ff4757';
                    speak('আমি কোনো ট্রেডিং চার্ট দেখতে পাচ্ছি না। অনুগ্রহ করে একটি ট্রেডিং চার্ট ওপেন করুন।');
                    run = false;
                    return;
                }
                st.innerText = 'ANALYZING...';
                st.style.color = '#ffa500';
                btn.style.borderColor = '#ffa500';
                speak('হ্যাঁ, আমি ট্রেডিং চার্ট দেখতে পাচ্ছি। এবং, বিশ্লেষণ করছি।', function(){
                    if(!run) return;
                    var sig = getBalancedRandomSignal();
                    if(sig === 'BUY'){
                        st.innerText = 'BUY SIGNAL';
                        st.style.color = '#2ed573';
                        btn.style.borderColor = '#2ed573';
                        speak('নিশ্চিন্তে বাই ট্রেড নিতে পারেন।');
                    } else {
                        st.innerText = 'SELL SIGNAL';
                        st.style.color = '#ff4757';
                        btn.style.borderColor = '#ff4757';
                        speak('নিশ্চিন্তে সেল ট্রেড নিতে পারেন।');
                    }
                });
            }
        };
    }
})();
